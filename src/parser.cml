(* String wrapper for caml_parser.run; existing Ast types, no I/O or state. *)
structure CandleParser = struct
  fun parse input = case CandleFrontEnd.parse_tree input of
      Inl error => Inl error
    | Inr [pt] => CandleDeclarations.ptree_Start pt
    | Inr _ => Inl (CandleSupport.unknown_loc,"Impossible: run_parser");
end;
