("corpus/ocaml-streams.ml","(* Tests for recursive non-function declarations. *)\010\010type 'a stream = Cons of (unit -> 'a * 'a stream)\010\010let zipWith f =\010  let rec inner (Cons xf) (Cons yf) =\010    let x, xs = xf () and y, ys = yf () in\010    Cons (fun () -> f x y, inner xs ys)\010  in\010  inner\010\010let tail (Cons xf) = let x, xs = xf () in xs\010\010(*\010let rec fibs =\010  Cons (fun () -> 0, Cons (fun () -> 1, zipWith (+) fibs (tail fibs)))\010*)\010let fibs = let rec f a b = Cons (fun () -> a, f b (a + b)) in f 0 1\010\010let rec at (Cons xf) =\010  let x, xs = xf () in\010  function\010    | 0 -> x\010    | n -> at xs (pred n)\010\010let fib = at fibs\010\010let rec falseTrue = Cons (fun () -> false, Cons (fun () -> true, falseTrue))\010\010let rec zeroOne = Cons (fun () -> 0, oneZero)\010    and oneZero = Cons (fun () -> 1, zeroOne)\010\010let like b n =\010  match b, n with\010  | false, 0 | true, 1 -> true\010  | _ -> false\010\010let streamsLike = zipWith like falseTrue zeroOne\010\010(* Taken from fib.ml *)\010module Main = struct\010  let rec doit n =\010    if n = 0 then\010      ()\010    else\010      let _ = if 165580141 <> fib 41 then failwith \"fibs\" in\010      let _ = if not (at streamsLike n) then failwith \"streamsLike\" in\010      doit (n - 1)\010end\010\010let x = \"Start\"\010let x = Main.doit 1\010let x = \"Stop\"\010",(Inr [(Ast.Dtype (Ast.Locs (Ast.Posn 2 0) (Ast.Posn 2 48)) [(["a"],("stream",[("Cons",[(Ast.Atfun (Ast.Atapp [] (Ast.Short "unit")) (Ast.Attup [(Ast.Atvar "a"),(Ast.Atapp [(Ast.Atvar "a")] (Ast.Short "stream"))]))])]))]),(Ast.Dlet (Ast.Locs (Ast.Posn 4 0) (Ast.Posn 9 6)) (Ast.Pvar "zipWith") (Ast.Fun "f" (Ast.Letrec [("inner",("",(Ast.Mat (Ast.Ident (Ast.Short "")) [((Ast.Pcon (Some (Ast.Short "Cons")) [(Ast.Pvar "xf")]),(Ast.Fun "" (Ast.Mat (Ast.Ident (Ast.Short "")) [((Ast.Pcon (Some (Ast.Short "Cons")) [(Ast.Pvar "yf")]),(Ast.Mat (Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "xf")),(Ast.Con None [])]) [((Ast.P