("corpus/hol-light-lib-prefix.ml","(* ========================================================================= *)\010(* Convenient library functions.                                             *)\010(*                                                                           *)\010(*       John Harrison, University of Cambridge Computer Laboratory          *)\010(*                                                                           *)\010(*            (c) Copyright, University of Cambridge 1998                    *)\010(*              (c) Copyright, John Harrison 1998-2007                       *)\010(* ========================================================================= *)\010\010let fail() = failwith \"\";;\010\010(* ------------------------------------------------------------------------- *)\010(* Combinators.                                                              *)\010(* ------------------------------------------------------------------------- *)\010\010let curry f x y = f(x,y);;\010\010let uncurry f(x,y) = f x y;;\010\010let I x = x;;\010\010let K x y = x;;\010\010let C f x y = f y x;;\010\010let W f x = f x x;;\010\010let (o) = fun f g x -> f(g x);;\010\010let (F_F) = fun f g (x,y) -> (f x,g y);;\010\010let (|>) = fun x f -> f x;;\010\010(* ------------------------------------------------------------------------- *)\010(* List basics.                                                              *)\010(* ------------------------------------------------------------------------- *)\010\010let hd l =\010  match l with\010   h::t -> h\010  | _ -> failwith \"hd\";;\010\010let tl l =\010  match l with\010   h::t -> t\010  | _ -> failwith \"tl\";;\010\010let map f =\010  let rec mapf l =\010    match l with\010      [] -> []\010    | (x::t) -> let y = f x in y::(mapf t) in\010  mapf;;\010\010let rec last l =\010  match l with\010    [x] -> x\010  | (h::t) -> last t\010  | [] -> failwith \"last\";;\010\010let rec butlast l =\010  match l with\010   