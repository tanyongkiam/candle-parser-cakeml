("corpus/ocaml-fib.ml","(* Translated from\010   https://github.com/MLton/mlton/blob/master/benchmark/tests/fib.sml *)\010\010let rec fib = function\010  | 0 -> 0\010  | 1 -> 1\010  | n -> fib (n - 1) + fib (n - 2)\010\010module Main = struct\010  let rec doit n =\010    if n = 0 then\010      ()\010    else\010      let _ = if 165580141 <> fib 41 then failwith \"bug\" else () in\010      doit (n - 1)\010end\010\010let x = \"Start\"\010let x = Main.doit 1\010let x = \"Stop\"\010",(Inr [(Ast.Dletrec (Ast.Locs (Ast.Posn 3 0) (Ast.Posn 6 33)) [("fib",("",(Ast.App Ast.Opapp [(Ast.Fun "" (Ast.Mat (Ast.Ident (Ast.Short "")) [((Ast.Plit (Ast.Intlit ( 0))),(Ast.Lit (Ast.Intlit ( 0)))),((Ast.Plit (Ast.Intlit ( 1))),(Ast.Lit (Ast.Intlit ( 1)))),((Ast.Pvar "n"),(Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "+")),(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "fib")),(Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "-")),(Ast.Ident (Ast.Short "n"))]),(Ast.Lit (Ast.Intlit ( 1)))])])]),(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "fib")),(Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "-")),(Ast.Ident (Ast.Short "n"))]),(Ast.Lit (Ast.Intlit ( 2)))])])]))])),(Ast.Ident (Ast.Short ""))])))]),(Ast.Dmod "Main" [(Ast.Dletrec (Ast.Locs (Ast.Posn 9 2) (Ast.Posn 14 17)) [("doit",("n",(Ast.If (Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "=")),(Ast.Ident (Ast.Short "n"))]),(Ast.Lit (Ast.Intlit ( 0)))]) (Ast.Con None []) (Ast.Let None (Ast.If (Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "<>")),(Ast.Lit (Ast.Intlit ( 165580141)))]),(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "fib")),(Ast.Lit (Ast.Intlit ( 41)))])]) (Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "failwith")),(Ast.Lit (Ast.Strlit "bug"))]) (Ast.Con None [])) (Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "doit")),(Ast.App Ast.Opapp [(Ast.App Ast.Opapp [(Ast.Ident (Ast.Short "-")),(Ast.Ident (Ast.Short "n"))]),(Ast.Lit (Ast.Intlit ( 1)))])])))))])]),(Ast.Dlet (Ast.Locs (A