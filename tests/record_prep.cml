val _ = List.app (fn (name,check) => ParserTests.check ("record-prep/" ^ name) (check ()))
  recordprep_golden;

val _ = ParserTests.check "record-prep/sort then extract and tuple-pack"
  (let val l = CandleSupport.unknown_loc;
       val a = Ast.Atvar "'a";
       val b = Ast.Atvar "'b";
       val sorted = CandleTypeDeclarations.sort_records
         (l,[],"t",[Inr ("Foo",[("z",b),("a",a)])]);
   in CandleTypeDeclarations.extract_record_defns sorted = [(l,"Foo",["a","z"])] andalso
      CandleTypeDeclarations.strip_record_fields sorted =
        (l,[],"t",[("Foo",[Ast.Attup [a,b]])])
   end);
val _ = ParserTests.check "record-prep/partition reverses each group"
  (let val l = CandleSupport.unknown_loc;
       val ty = Ast.Atvar "a";
   in CandleTypeDeclarations.partition_types
        [(l,[],"t",Inl ty),(l,[],"d",Inr []),(l,[],"u",Inl ty),(l,[],"e",Inr [])] =
      ([(l,[],"u",ty),(l,[],"t",ty)],[(l,[],"e",[]),(l,[],"d",[])])
   end);
val _ = print "RECORD_PREP_TESTS_OK\n";
