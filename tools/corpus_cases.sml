("records/raw","(* Record syntax in Candle. *)\010\010(* Records are declared as part of datatypes. It is possible to mix classic\010 * datatype constructors and record constructors freely.\010 *)\010type thing =\010  | Aa of int\010  | Bb of { integer: int; boolean: bool; a_string: string }\010;;\010\010(* Records support pattern matching. It is possible to do partial matches. *)\010let m1 t =\010  match t with\010  | Aa n -> n\010  | Bb {integer} -> integer;;\010\010(* Pattern matching on records works in the outermost pattern. Nested record\010 * patterns are not supported.\010 *)\010let Bb { a_string } = Bb { a_string = \"5\"; boolean = false; integer = 1 };;\010\010(* Records are constructed with this syntax: *)\010let x = Bb { a_string = \"1\"; boolean = false; integer = 2 };;\010let y = Aa 5;;\010\010(* Records can be updated using 'with'. This updates the record 'x': *)\010let z = Bb { x with boolean = true; integer = 3; };;\010\010(* Record projection is done with dots, using the name of the constructor and\010 * the name of the field: *)\010let s = z.Bb.a_string;;\010\010print (s ^ \"\\n\");;\010print (Int.toString (m1 x) ^ \" \" ^ Int.toString (m1 y) ^ \"\\n\");;\010print (a_string ^ \"\\n\");;\010\010module Mod = struct\010  type blob = Cc of { cc: bool };;\010  let x = Cc { cc = true };;\010end;;\010\010(* It's possible to use records with qualified constructors:\010 * - Mod.x is to access the value x,\010 * - Mod.Cc is for the record constructor in Cc in Mod, and\010 * - cc is the field in the record Cc: *)\010print \"cc=\";;\010print (if Mod.x.Mod.Cc.cc then \"true\\n\" else \"false\\n\");;\010\010(* Limitations:\010 * - It is not possible to name the matched fields in record pattern matches\010 * - Record constructors are present in all record-related syntax. This is\010 *   because records are implemented as a syntax extension in the Candle parser,\010 *   and the parser does not know what names belong to what records.\010 *)\010"),
("boot/Candle-only-projection","(* ------------------------------------------------------------------------- *\010 * Prelude\010 * ------------------------------------------------------------------------- *)\010\010(* This is pointer equality, which is missing from CakeML.\010   The way we want to implement this is by using (=) for mutable types such as\010   references, and false otherwise.\010   By defining (==) as follows, we get the correct behavior for reference types,\010   and type errors everywhere else. Those need to be manually fixed, using (=)\010   for mutable types, and false otherwise. The hope is that the type error\010   messages make this decision easier.\010 *)\010let (==) x y = !x; !y; x = y\010\010let ref x = Ref x;;\010\010let (/) x y = div x y;;\010let (-.) x y = Double.(-) x y;;\010let (+.) x y = Double.(+) x y;;\010let ( *.) x y = Double.( * ) x y;;\010let (/.) x y = Double.(/) x y;;\010let ( ** ) x y = Double.pow x y;;\010let (||) x y = x || y;;\010\010let log x = Double.ln x;;\010\010(* OCaml parser doesn't like ~, and the CakeML parser doesn't like ~- nor ~-. *)\010     \010                   \010                        \010  \010let (~-) x = negint x;;\010let (~-.) x = negfloat x;;\010\010let failwith msg = raise (Failure msg);;\010\010(* This is the pretty printer for exceptions, and you need to update it\010   each time you add an exception definition if you want it to print something\010   informative (see e.g. exception Unchanged in lib.ml).\010 *)\010\010let pp_exn e =\010  match e with\010  | Chr  -> Pretty_printer.token \"Chr\"\010  | Div  -> Pretty_printer.token \"Div\"\010  | Bind -> Pretty_printer.token \"Bind\"\010  | Subscript -> Pretty_printer.token \"Subscript\"\010  | Interrupt -> Pretty_printer.token \"Interrupt\"\010  | Failure s -> Pretty_printer.app_block \"Failure\" [Pretty_printer.pp_string s]\010  | _ -> Pretty_printer.token \"<exn>\";;\010\010     \010                                         \010                      \010  \010\010(* Some conversions in OCaml style: *)\010\010let string_of_int n =\010  if n < 0 then \"-\" ^ Int.toString (-n)\010  else Int.toString n\010;;\010\010let pp_int n = Pretty_printer.token (string_of_int n);;\010\010let pp_rat r =\010  let n = Rat.numerator r in\010  let d = Rat.denominator r in\010  Pretty_printer.token (string_of_int n ^ \"/\" ^ string_of_int d)\010;;\010\010let string_of_float = Double.toString;;\010\010let int_of_string = Option.valOf o Int.fromString;;\010\010(* Left shifting integers. HOL Light expects these to not be bigints, so I\010   suppose we can just map in and out of word64. *)\010let (lsl) x y =\010  Word64.toInt (Word64.(<<) (Word64.fromInt x) y);;\010let (lsr) x y =\010  Word64.toInt (Word64.(>>) (Word64.fromInt x) y);;\010\010let (land) x y =\010  Word64.toInt (Word64.andb (Word64.fromInt x) (Word64.fromInt y));;\010let (lor) x y =\010  Word64.toInt (Word64.orb (Word64.fromInt x) (Word64.fromInt y));;\010let (lxor) x y =\010  Word64.toInt (Word64.xorb (Word64.fromInt x) (Word64.fromInt y));;\010let lnot x =\010  Word64.toInt (Word64.notb (Word64.fromInt x));;\010\010\010(* TODO Need a better string escaping thing. *)\010let string_escaped =\010  let rec escape cs =\010    match cs with\010    | [] -> []\010    | '\\\\'::l -> '\\\\'::'\\\\'::escape l\010    | '\\b'::l -> '\\\\'::'b'::escape l\010    | '\\t'::l -> '\\\\'::'t'::escape l\010    | '\\n'::l -> '\\\\'::'n'::escape l\010    | '\"'::l -> '\\\\'::'\"'::escape l\010    | c::l -> c::escape l in\010  fun s -> String.implode (escape (String.explode s));;\010\010(* Add printers for things we deal with differently, e.g. bool, app_list, etc *)\010\010let pp_bool b = Pretty_printer.token (if b then \"true\" else \"false\");;\010\010let pp_char c =\010  Pretty_printer.token (\"'\" ^ string_escaped (String.str c)  ^ \"'\");;\010\010let rec pp_app_list f xs =\010  match xs with\010  | Nil -> Pretty_printer.token \"Nil\"\010  | List xs ->\010      Pretty_printer.app_block \"List\" [Pretty_printer.pp_list f xs]\010  | Append (l, r) ->\010      Pretty_printer.app_block \"Append\" [\010        Pretty_printer.tuple [pp_app_list f l; pp_app_list f r]]\010;;\010\010let abs x = if x < 0 then -x else x;;\010\010let ignore x = x; ();;\010\010let rec rev_append xs acc =\010  match xs with\010  | [] -> acc\010  | x::xs -> rev_append xs (x::acc);;\010\010let concat_map f =\010  let rec concat acc xs =\010    match acc with\010    | [] -> map xs\010    | a::acc -> a::concat acc xs\010  and map xs =\010    match xs with\010    | [] -> []\010    | x::xs -> concat (f x) xs in\010  map;;\010\010(* ------------------------------------------------------------------------- *\010 * Helpful banner\010 * ------------------------------------------------------------------------- *)\010\010let _ = List.app print [\010  \"\\n\";\010  \"---------------------------------------\\n\";\010  \"                Candle                 \\n\";\010  \"---------------------------------------\\n\";\010  \"\\n\";\010  \"\\n\";\010  ];;\010\010(* ------------------------------------------------------------------------- *\010 * Operations on filenames\010 * ------------------------------------------------------------------------- *)\010\010module Filename = struct\010  let currentDir = \".\";;\010  let parentDir = \"..\";;\010  let dirSep = \"/\";;\010  let isRelative fname =\010    try String.sub fname 0 <> '/'\010    with Subscript -> true;;\010  let concat dname fname =\010    if dname = currentDir then fname\010    else String.concat [dname; dirSep; fname];;\010  let (basename, dirname) =\010    let trimSep s = (* trim trailing separators *)\010      let len = String.size s in\010      let dsl = String.size dirSep in\010      let rec search i =\010        if i < dsl then s\010        else if String.substring s i dsl = dirSep then\010          search (i - dsl)\010        else\010          String.substring s 0 i in\010      search (len - 1) in\010    let splitPath s =\010      let len = String.size s in\010      let dsl = String.size dirSep in\010      let s = trimSep s in\010      let rec search i =\010        if i <= dsl then\010          (currentDir, s)\010        else if String.substring s i dsl = dirSep then\010          (String.substring s 0 (i - 1),\010           String.extract s (i + dsl) None)\010        else\010          search (i - dsl) in\010      search (len - 1) in\010    ((fun s -> let (_, b) = splitPath s in b),\010     (fun s -> let (d, _) = splitPath s in d))\010end;; (* struct *)\010\010(* ------------------------------------------------------------------------- *\010 * Double-ended functional queue\010 * ------------------------------------------------------------------------- *)\010\010module Queue = struct\010  type 'a queue = 'a list * 'a list;;\010  let push_back (xs, ys) y = (xs, y::ys);;\010  let push_front (xs, ys) x = (x::xs, ys);;\010  let rec dequeue (xs, ys) =\010    match xs with\010    | x::xs -> Some (x, (xs, ys))\010    | [] ->\010        match ys with\010        | [] -> None\010        | _ -> dequeue (List.rev ys, []);;\010  let empty = ([], []);;\010  let flush (xs, ys) = xs @ List.rev ys;;\010end;; (* struct *)\010\010(* ------------------------------------------------------------------------- *\010 * Imperative wrapper around Queue\010 * ------------------------------------------------------------------------- *)\010\010module Buffer = struct\010  type 'a buffer = 'a Queue.queue ref;;\010  let push_back q x = q := Queue.push_back (!q) x;;\010  let push_front q x = q := Queue.push_front (!q) x;;\010  let dequeue q =\010    match Queue.dequeue (!q) with\010    | None -> None\010    | Some (x, q') ->\010        q := q';\010        Some x;;\010  let empty () = ref Queue.empty;;\010  let flush q =\010    let els = Queue.flush (!q) in\010    q := Queue.empty;\010    els\010end;; (* struct *)\010\010(* ------------------------------------------------------------------------- *\010 * Operations on strings\010 * ------------------------------------------------------------------------- *)\010\010let trimLeft str =\010  let rec nom n =\010    if n >= String.size str then str\010    else if Char.isSpace (String.sub str n) then nom (n + 1)\010    else String.extract str n None in\010  nom 0\010  ;;\010\010let trimRight str =\010  let rec nom n =\010    if n < 1 then str\010    else if Char.isSpace (String.sub str n) then nom (n - 1)\010    else String.substring str 0 (n + 1) in\010  nom (String.size str - 1)\010;;\010\010(* ------------------------------------------------------------------------- *\010 * Operations on files\010 * ------------------------------------------------------------------------- *)\010\010let isFile fname =\010  try let ins = Text_io.openIn fname in\010      Text_io.closeIn ins;\010      true\010  with Text_io.Bad_file_name -> false\010;;\010\010(* ------------------------------------------------------------------------- *\010 * Lexer for enough parts of the language to keep track on whether semi-colons\010 * appear on the top-level or not.\010 * ------------------------------------------------------------------------- *)\010\010module Lexer = struct\010\010type directive =\010  | D_load\010  | D_need\010  | D_use\010;;\010\010let string_of_directive d =\010  match d with\010  | D_load -> \"load\"\010  | D_need -> \"need\"\010  | D_use -> \"use\"\010;;\010\010type token =\010  | T_begin | T_end | T_struct | T_sig | T_semis | T_newline\010  | T_use | T_needs | T_loads (* converted into directives *)\010  | T_other of string\010  | T_symb of string\010  | T_comment of string\010  | T_string of string\010  | T_quote of string\010  | T_char of string\010  | T_number of string\010  | T_spaces of string\010  | T_done (* pseudo-token after loading a file *)\010;;\010\010let string_of_token unquote tok =\010  match tok with\010  | T_begin -> \"begin\"\010  | T_end -> \"end\"\010  | T_struct -> \"struct\"\010  | T_sig -> \"sig\"\010  | T_semis -> \";;\"\010  | T_newline -> \"\\n\"\010  | T_string s -> \"\\\"\" ^ s ^ \"\\\"\"\010  | T_quote s ->\010      begin\010        match unquote with\010        | None -> \"`\" ^ s ^ \"`\"\010        | Some f -> \"(\" ^ f s ^ \")\"\010      end\010  | T_char s -> \"'\" ^ s ^ \"'\"\010  | T_comment s | T_other s | T_symb s | T_number s | T_spaces s -> s\010  | T_use -> \"#use\"\010  | T_loads -> \"loads\"\010  | T_needs -> \"needs\"\010  | T_done -> \"(* shouldn't happen *)\"\010;;\010\010let directive_of_token t =\010  match t with\010  | T_needs -> Some D_need\010  | T_loads -> Some D_load\010  | T_use -> Some D_use\010  | _ -> None\010;;\010\010let scan nextChar peekChar =\010  let quoteSym c = c = '`' in\010  let tok_from_keyword =\010    let keywords = [\010      \"begin\",  T_begin;\010      \"end\",    T_end;\010      \"struct\", T_struct;\010      \"sig\",    T_sig;\010      (* top-level directives *)\010      \"#use\",   T_use;\010      \"needs\",  T_needs;\010      \"loads\",  T_loads;\010    ] in\010    fun s -> match Alist.lookup keywords s with\010             | None -> T_other s\010             | Some tok -> tok in\010  let is_symbol =\010    let symchars = String.explode \"#$&*+-/=>@^|~!?%<:.()[]{},\" in\010    fun c -> List.exists (fun x -> x = c) symchars in\010  let is_alpha c =\010    Char.(<=) 'a' c && Char.(<=) c 'z' ||\010    Char.(<=) 'A' c && Char.(<=) c 'Z' in\010  let is_digit c =\010    Char.(<=) '0' c && Char.(<=) c '9' in\010  let is_name_char c =\010    is_alpha c || is_digit c || c = '_' || c = '\\'' in\010  let is_int_char c =\010    is_digit c || c = '_' || c = 'l' || c = 'L' || c = 'n' in\010  let scan_while acc pred =\010    let rec nom acc =\010      Interrupt.check ();\010      match peekChar () with\010      | None -> None\010      | Some c when pred c ->\010          nextChar ();\010          nom (c::acc)\010      | _ -> Some (String.implode (List.rev acc)) in\010    nom acc in\010  let scan_comment () =\010    let rec nom acc level =\010      Interrupt.check ();\010      if level = 0 then\010        Some (String.implode ('('::'*'::List.rev acc))\010      else\010        match nextChar () with\010        | Some '(' ->\010            begin\010              match peekChar () with\010              | Some '*' ->\010                  nextChar ();\010                  nom ('*'::'('::acc) (level + 1)\010              | _ -> nom ('('::acc) level\010            end\010        | Some '*' ->\010            begin\010              match peekChar () with\010              | Some ')' ->\010                  nextChar ();\010                  nom (')'::'*'::acc) (level - 1)\010              | _ -> nom ('*'::acc) level\010            end\010        | Some c -> nom (c::acc) level\010        | None -> None in\010    nom [] 1 in\010  let scan_name c =\010    match scan_while [c] is_name_char with\010    | None -> None\010    | Some s -> Some (tok_from_keyword s) in\010  let scan_symb c =\010    Option.map (fun s -> T_symb s)\010               (scan_while [c] is_symbol) in\010  let scan_int c =\010    Option.map (fun s -> T_number s)\010               (scan_while [c] is_int_char) in\010  let scan_quote () =\010    match scan_while [] (not o quoteSym) with\010    | None -> None\010    | Some str ->\010        nextChar ();\010        Some (T_quote str) in\010  let skip_line () =\010    scan_while [] (fun x -> x <> '\\n');\010    nextChar () in\010  let scan_spaces c =\010    Option.map (fun s -> T_spaces s)\010               (scan_while [c] (fun c -> c <> '\\n' && Char.isSpace c)) in\010  let scan_escaped ch =\010    let rec nom acc =\010      Interrupt.check ();\010      match nextChar () with\010      | None -> None\010      | Some '\\\\' ->\010          begin\010            match nextChar () with\010            | None -> nom ('\\\\'::acc)\010            | Some c -> nom (c::'\\\\'::acc)\010          end\010      | Some c when c = ch -> Some (String.implode (List.rev acc))\010      | Some c -> nom (c::acc) in\010    nom [] in\010  let scan_strlit () =\010    Option.map (fun s -> T_string s)\010               (scan_escaped '\"') in\010  (* This code will intentionally let through some bad tokens (it doesn't check\010     whether escape sequences are well formed), but those will get stuck in the\010     real lexer. *)\010  let scan_charlit_or_tyvar () =\010    match peekChar () with\010    (* Escaped character literal *)\010    | Some '\\\\' ->\010        begin\010          nextChar ();\010          Option.map (fun s -> T_char (\"\\\\\" ^ s))\010                     (scan_escaped '\\'')\010        end\010    (* A single tick, start of a type variable, but followed by space *)\010    | Some ' ' | Some '\\n' | Some '\\t' | Some '\\r' -> Some (T_other \"'\")\010    (* Regular character literal, or a type variable *)\010    | Some c ->\010        begin\010          nextChar ();\010          match peekChar () with\010          (* Regular character literal *)\010          | Some '\\'' ->\010              begin\010                nextChar ();\010                Some (T_char (String.str c))\010              end\010          (* Type variable *)\010          | Some _ -> Option.map (fun s -> T_other s)\010                                 (scan_while [c; '\\''] is_name_char)\010          | None -> Some (T_other (String.implode ['\\''; c]))\010        end\010    (* Two ticks following each other: '' *)\010    | Some '\\'' -> Some (T_symb \"''\")\010    | None -> Some (T_symb \"'\") in\010  let rec nextToken () =\010    match nextChar () with\010    | None -> None\010    (* Attempt to scan semis *)\010    | Some ';' ->\010        begin\010          match peekChar () with\010          | Some ';' ->\010              nextChar ();\010              Some T_semis\010          | _ -> scan_symb ';'\010        end\010    (* Attempt to scan comment *)\010    | Some '(' ->\010        begin\010          match peekChar () with\010          | Some '*' ->\010              nextChar ();\010              begin\010                match scan_comment () with\010                | None -> Some (T_symb \"(*\")\010                | Some str -> Some (T_comment str)\010              end\010          | _ -> Some (T_symb \"(\")\010        end\010    (* Attempt to scan char literal or type variable *)\010    | Some '\\'' -> scan_charlit_or_tyvar ()\010    (* Attempt to scan string literal *)\010    | Some '\"' -> scan_strlit ()\010    (* A #use directive, maybe: *)\010    | Some '#' -> scan_name '#'\010    (* Newlines *)\010    | Some '\\n' -> Some T_newline\010    (* Anything else *)\010    | Some c ->\010        if quoteSym c then\010          scan_quote ()\010        else if is_digit c then\010          scan_int c\010        else if is_symbol c then\010          scan_symb c\010        else if is_alpha c || c = '_' then\010          scan_name c\010        else if Char.isSpace c then\010          scan_spaces c\010        else\010          Some (T_other (String.str c)) in\010  fun () -> Interrupt.check (); nextToken ()\010;;\010\010end;; (* struct *)\010\010(* ------------------------------------------------------------------------- *\010 * CakeML struct: setting up REPL, reading/loading.\010 * ------------------------------------------------------------------------- *)\010\010module Cakeml = struct\010\010let loadPath = ref [Filename.currentDir];;\010let stdIn = Text_io.openStdIn ();;\010let (input1 : (unit -> char option) ref) =\010  ref (fun () -> Text_io.input1 stdIn);;\010\010let prompt1 = ref \"# \";;\010let prompt2 = ref \"  \";;\010let userInput = ref true;;\010\010let unquote = ref (fun (s: string) -> s);;\010\010exception Repl_error;;\010\010let () =\010  let prompt = ref (!prompt2) in\010  let pushLoad, popLoad, clearLoadStack =\010    let stack = ref ([]: string list) in\010    let pushLoad fname = stack := fname :: !stack in\010    let popLoad () =\010      match !stack with\010      | fname :: rest as res -> stack := rest; Some (fname, rest)\010      | _ -> None in\010    let clearLoadStack () = stack := [] in\010    pushLoad, popLoad, clearLoadStack in\010  let peekChar, nextChar =\010    let lookahead = ref (None: char option) in\010    let peek () =\010      match !lookahead with\010      | Some c -> Some c\010      | None ->\010          match (!input1) () with\010          | None -> None\010          | Some c ->\010              lookahead := Some c;\010              Some c in\010    let next () =\010      match !lookahead with\010      | None -> (!input1) ()\010      | Some c ->\010          lookahead := None;\010          Some c in\010    peek, next in\010  (* Load files from disk and keep track on what has been loaded.\010   *)\010  let load =\010    let loadedFiles = (ref [] : string list ref) in\010    let loadMsg s = print (\"- Loading \" ^ s ^ \"\\n\") in\010    let load_use fname =\010      loadMsg fname;\010      Text_io.inputLinesFile '\\n' fname in\010    let load fname =\010      loadMsg fname;\010      match Text_io.inputLinesFile '\\n' fname with\010      | None -> None\010      | Some lns ->\010          begin\010            if not (List.exists (fun x -> x = fname) (!loadedFiles)) then\010             loadedFiles := fname :: !loadedFiles\010          end;\010          Some lns in\010    let load1 fname =\010      if List.exists (fun x -> x = fname) (!loadedFiles) then\010        begin\010          print (\"- Already loaded: \" ^ fname ^ \"\\n\");\010          None\010        end\010      else\010        load fname in\010    let loadOnPath pragma fname =\010      let paths = List.map (fun p -> Filename.concat p fname) (!loadPath) in\010      match List.find isFile paths with\010      | None ->\010          print (\"- No such file: \" ^ fname ^ \"\\n\");\010          Repl.nextString := \"\";\010          failwith (\"No such file : \" ^ fname)\010      | Some fname ->\010          let loader = match pragma with\010                       | Lexer.D_load -> load\010                       | Lexer.D_need -> load1\010                       | Lexer.D_use -> load_use in\010          (match loader fname with\010          | None -> []\010          | Some ls -> ls) in\010    loadOnPath in\010  (* Instantiate lexer *)\010  let scan1 = Lexer.scan nextChar peekChar in\010  (* Enqueue input here *)\010  let input_buffer = (Buffer.empty () : Lexer.token Buffer.buffer) in\010  (* Set up a nextChar/peekChar pair on the list of lines, lex all of it,\010   * and then stuff it all into input_buffer.\010   *)\010  let scan_lines lines =\010    let inp = ref lines in\010    let idx = ref 0 in\010    let rec peekChar () =\010      match !inp with\010      | [] -> None\010      | s::ss ->\010          try Some (String.sub s (!idx))\010          with Subscript ->\010            (* Look into next string. It should not be empty. *)\010            match ss with\010            | [] -> None\010            | s::ss -> try Some (String.sub s 0)\010                       with Subscript -> None in\010    let rec nextChar () =\010      match !inp with\010      | [] -> None\010      | s::ss ->\010          try let res = String.sub s (!idx) in\010              idx := (!idx) + 1;\010              Some res\010          with Subscript ->\010            idx := 0;\010            inp := ss;\010            nextChar () in\010    let scan = Lexer.scan nextChar peekChar in\010    let rec nom acc =\010      match scan () with\010      | None -> List.app (Buffer.push_front input_buffer) (Lexer.T_done :: acc)\010      | Some tok -> nom (tok::acc) in\010    nom [] in\010  let next () =\010    match Buffer.dequeue input_buffer with\010    | Some tok -> Some tok\010    | None -> scan1 () in\010  let output_buffer = (Buffer.empty () : Lexer.token Buffer.buffer) in\010  let rec next_nonspace () =\010    match next () with\010    | Some (Lexer.T_spaces _) -> next_nonspace ()\010    | res -> res in\010  let rec scan level =\010    try match next () with\010        | None -> None\010        (* Attempt to use token as part of loading directive if it sits at the\010           top level (i.e. not inside parenthesis). The REPL fails and reports\010           and error unless the token is followed by a string literal and then\010           double semicolons. Ideally we should also check that the token sits\010           at the start of the line, but we don't, so odd things such as this:\010             foo needs \"bar.ml\";;\010           are OK and will cause the file bar.ml to be loaded and appear\010           directly after 'foo' in the token stream.\010         *)\010        | Some (Lexer.T_use | Lexer.T_needs | Lexer.T_loads as tok)\010          when level = 0 ->\010            begin\010              let dir = Option.valOf (Lexer.directive_of_token tok) in\010              match next_nonspace () with\010              (* Attempt to convert into directive: *)\010              | Some (Lexer.T_string fname as tok') ->\010                  begin\010                    match next_nonspace () with\010                    (* OK directive, perform load: *)\010                    | Some (Lexer.T_semis) ->\010                        let lines = load dir fname in\010                        if List.null lines then scan level else\010                          begin\010                            pushLoad fname;\010                            userInput := false;\010                            scan_lines lines;\010                            scan level\010                          end\010                    (* Malformed *)\010                    | _ ->\010                        failwith\010                          (String.concat [\010                             \"\\nREPL error: \";\010                             Lexer.string_of_directive dir;\010                             \" \\\"string\\\" should be followed by a double\";\010                             \" semicolon [;;].\\n\"])\010                  end\010              (* Malformed *)\010              | _ ->\010                  failwith\010                    (String.concat [\010                       \"\\nREPL error: \";\010                       Lexer.string_of_directive dir;\010                       \" should be followed by a \\\"string literal\\\" and then a\";\010                       \" double semicolon [;;].\\n\"])\010            end\010        | Some (Lexer.T_done) ->\010            (match popLoad () with\010             | Some (fname, rest) -> (\010               print (\"- Finished loading \" ^ fname ^ \"\\n\");\010               if List.null rest then userInput := true)\010             | None -> failwith \"candle_boot.ml: scan - should be unreachable\");\010            scan level\010        | Some tok ->\010            Buffer.push_back output_buffer tok;\010            match tok with\010            | Lexer.T_begin | Lexer.T_struct | Lexer.T_sig ->\010                scan (level + 1)\010            | Lexer.T_end -> scan (level - 1)\010            | Lexer.T_semis when level = 0 ->\010                prompt := !prompt1;\010                Some (Buffer.flush output_buffer)\010            | Lexer.T_newline when !userInput ->\010                print (!prompt);\010                prompt := !prompt2;\010                scan level\010            | _ -> scan level\010    with Interrupt ->\010      print \"Compilation interrupted\\n\";\010      raise Repl_error in\010  let checkError () =\010    let err = !Repl.errorMessage in\010    Repl.errorMessage := \"\";\010    if err <> \"\" then raise Repl_error in\010  let next () =\010    try checkError ();\010        match scan 0 with\010        | None ->\010            Repl.isEOF := true;\010            Repl.nextString := \"\"\010        | Some ts ->\010            Repl.isEOF := false;\010            Repl.nextString :=\010              String.concat\010                (List.map (Lexer.string_of_token (Some (!unquote))) ts)\010    with Repl_error ->\010      if not (!userInput) then print (!prompt1);\010      Buffer.flush input_buffer;\010      Buffer.flush output_buffer;\010      clearLoadStack ();\010      Repl.nextString := \"\";\010      userInput := true in\010  Repl.readNextString := (fun () ->\010    print (!prompt1);\010    next ();\010    Repl.readNextString := next)\010;;\010\010end;; (* struct *)\010")
];
